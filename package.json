{
  "name": "lab_1",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": "24.14.0"
  },
  "imports": {
    "#db/*": "./db/*",
    "#configs/*": "./configs/*",
    "#constants/*": "./constants/*",
    "#controllers/*": "./controllers/*",
    "#data/*": "./data/*",
    "#repositories/*": "./repositories/*",
    "#routes/*": "./routes/*",
    "#schemas/*": "./schemas/*",
    "#src/*": "./src/*",
    "#state/*": "./state/*",
    "#utils/*": "./utils/*"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "external": "json-server db.json --port 3001",
    "seed": "node --env-file=.env src/scripts/seed.js",
    "seed:force": "node --env-file=.env src/scripts/seed.js --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint -c ./configs/eslint/eslint.config.js .",
    "lint:fix": "eslint -c ./configs/eslint/eslint.config.js --fix .",
    "format": "prettier -c ./configs/prettier/.prettierrc . --write",
    "format:check": "prettier -c ./configs/prettier/.prettierrc . . --check",
    "check": "npm run lint && npm run format:check",
    "predev": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "json-server": "^0.17.4",
    "pino-pretty": "^13.1.3",
    "prettier": "3.8.1",
    "vitest": "^3.2.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.0.1",
    "fastify-session-redis-store": "^7.1.2",
    "mysql2": "^3.14.4"
  }
}
